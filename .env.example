# Application Port
PORT=3000

# Database Configuration (for Docker Compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_processing
DB_PORT=5432

# Connection string (used by Prisma Service)
# When running inside Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/image_processing?sslmode=disable

# When running locally outside Docker (connecting to Docker Compose Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_processing?sslmode=disable

# JWT Secrets & Expiry
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Automatic Prisma migration on container start ("true" or "false")
RUN_MIGRATIONS=true
